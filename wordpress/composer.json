{
  "name": "gioamato/stateless-wordpress",
  "description": "Stateless WordPress (K8s Ready)",
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org",
      "only": [
        "wpackagist-plugin/*",
        "wpackagist-theme/*"
      ]
    }
  ],
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true
    }
  },
  "require": {
    "wpackagist-plugin/nginx-cache": "1.0.8",
    "wpackagist-plugin/windows-azure-storage": "4.5.2",
    "wpackagist-theme/twentytwentyfive": "1.5"
  },
  "extra": {
    "installer-paths": {
      "wp-content/mu-plugins/{$name}/": [
        "wpackagist-plugin/nginx-cache"
      ]
    }
  }
}
